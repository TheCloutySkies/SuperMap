rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'lonnie034@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function notBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);
    }
    match /saved_items/{itemId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['article', 'place', 'map', 'report']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /profile_posts/{postId} {
      allow read: if true;
      allow create: if notBanned()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /boards/{boardId} {
      allow read: if true;
      allow create: if notBanned() && (
        request.resource.data.createdBy == 'starter'
        || (
          request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
        )
      );
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }
    match /threads/{threadId} {
      allow read: if true;
      allow create: if notBanned()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.boardId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 12000;
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if notBanned()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.threadId is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 12000;
      allow update: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /community_pins/{pinId} {
      allow read: if true;
      allow create: if notBanned()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.kind in ['x', 'news', 'image', 'shape', 'pin']
        && request.resource.data.geometryJson is string
        && request.resource.data.geometryJson.size() > 2
        && request.resource.data.geometryJson.size() <= 20000;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /bans/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids
          && request.resource.data.fromUid == request.auth.uid
          && (
            (request.resource.data.body is string && request.resource.data.body.size() > 0)
            || request.resource.data.keys().hasAny(['media', 'item'])
          )
          && (!request.resource.data.keys().hasAny(['body']) || request.resource.data.body.size() <= 4000)
          && (
            !request.resource.data.keys().hasAny(['expiresAtMs'])
            || (
              request.resource.data.expiresAtMs is number
              && request.resource.data.expiresAtMs >= request.time.toMillis() - 120000
              && request.resource.data.expiresAtMs <= request.time.toMillis() + 2764800000
            )
          )
          // A disappearing photo never stays longer than a week.
          && (
            !request.resource.data.keys().hasAny(['media'])
            || request.resource.data.expiresAtMs <= request.time.toMillis() + 604800000
          );
        allow update: if false;
        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids
          && resource.data.expiresAtMs is number
          && resource.data.expiresAtMs <= request.time.toMillis();
        // A photo message carries `media` with the object path; a photo never
        // outlives a week, whatever the chat's own timer says.
        match /typing/{uid} {
          allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids;
          allow write: if signedIn()
            && uid == request.auth.uid
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids;
        }
      }
    }
    match /admin_actions/{actionId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /audit/{entryId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /secure_drops/{dropId} {
      // The unguessable id is the capability, so a single document may be read.
      // Listing is refused: it would hand out every id in the collection.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.expiresAtMs is number
        && request.resource.data.expiresAtMs <= request.time.toMillis() + 600000;
      allow update: if false;
      // Only the sweeper (Admin SDK, which bypasses rules) deletes a drop.
      allow delete: if false;
    }
    // Batman cases: one document per case, private by default. A case marked
    // 'link' is readable by anyone holding its unguessable id; only the owner
    // may write it. Cases shipped without the account database stay local.
    match /cases/{caseId} {
      // `get` is the share capability; `list` is only ever the owner's own cases,
      // so nobody can page through every case that has ever been shared.
      allow get: if resource.data.visibility == 'link'
        || (signedIn() && request.auth.uid in resource.data.memberUids);
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && notBanned()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update, delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }
    // Enrichment queue: the client only ever asks; the Actions worker answers
    // with the Admin SDK, which bypasses these rules.
    match /scan_requests/{requestId} {
      allow read: if signedIn() && request.auth.uid == resource.data.ownerUid;
      allow create: if signedIn() && request.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /enrichment/{enrichmentId} {
      allow read: if signedIn() && request.auth.uid == resource.data.ownerUid;
      allow write: if false;
    }
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['broken', 'misleading', 'false', 'score']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000;
      allow read: if signedIn() && request.auth.token.email == 'lonnie034@gmail.com';
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
