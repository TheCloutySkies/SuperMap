# API base URL for situational awareness backend (OSINT feeds, advanced search, news, etc.)
# Optional. When unset, a page served from a real host talks to its own origin
# (/api/* and /health are proxied by vercel.json rewrites to the Render API) and a
# dev page talks to http://localhost:3001. Set it only to point somewhere else.
# VITE_API_URL=http://localhost:3001

# Optional Firebase (Auth + Firestore). Leave blank to use a local browser account.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shared snapshot the collector publishes to the orphan `data` branch.
# Every visitor reads these files from the CDN, so data updates never need a deploy.
# Default: https://raw.githubusercontent.com/TheCloutySkies/SuperMap/data
# VITE_SNAPSHOT_BASE=
