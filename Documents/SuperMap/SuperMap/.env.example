# API base URL for situational awareness backend (OSINT feeds, advanced search, news, etc.)
# When using "npm run dev" from repo root, the API runs on port 3001 automatically.
VITE_API_URL=http://localhost:3001

# Optional Firebase (Auth + Firestore). Leave blank to use a local browser account.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
