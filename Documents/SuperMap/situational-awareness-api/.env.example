PORT=3001
RAPIDAPI_KEY=

# Weather desk (/api/weather/*). Open-Meteo public APIs need no key.
# Windy API key (Render: WINDY_API). Used for:
# - Weather radar wind particles (/api/weather/windy/config — Map Forecast product)
# - Live Webcams map (/api/webcams — Webcams API v2 list/bbox proxy)
# Obtain at https://api.windy.com/keys. Never commit the value.
# Prefer a Webcams-capable key for /api/webcams; Map Forecast alone may 401 webcams.
WINDY_API=
# OpenWeatherMap: precip/temp tile fallback (+ wind only if Windy unset). Never commit it.
OPENWEATHERMAP_API_KEY=
# NWS requires a descriptive User-Agent (not an API key). Default is fine for SuperMap.
NWS_USER_AGENT=SuperMapWeather (goodpalantir@cloutyskies.org)

# MediaStack live news (merged into /api/news). Free tier: HTTP only, ~100–500 req/month.
# Pulled only at 08:00 and 15:00 America/New_York; disk-cached between pulls.
# Set the real key in Render / local .env — never commit it.
MEDIASTACK_API_KEY=

# Optional geocoding providers for /api/geocode fallback chain.
# The API will try Mapbox -> Geoapify -> Nominatim.
MAPBOX_TOKEN=
GEOAPIFY_KEY=

# Optional: Brave Search API for /api/search/searxng (recommended – free tier: brave.com/search/api)
# BRAVE_SEARCH_API_KEY=
# If unset, the API falls back to rotating public SearXNG instances (often rate-limited or down).

# AI Threat Summary + Crime Ask + feed risk tagging: Groq (hosted) and/or Ollama (local).
# Groq (recommended on Render): https://console.groq.com — set GROQ_API_KEY in Render env; never commit the key.
GROQ_API_KEY=
# GROQ_THREAT_MODEL=openai/gpt-oss-20b
# GROQ_THREAT_BACKUP_MODEL=qwen/qwen3.8-27b
# GROQ_THREAT_TIMEOUT_MS=60000
# Rate-limit safeguards for threat summary (app will not exceed these; set Groq UI limits ≥ these)
# GROQ_THREAT_MAX_CALLS_PER_24H=28
# GROQ_THREAT_MIN_INTERVAL_MS=3300000
# Separate lighter budget for per-feed AI tagging / risk scoring (1–5). Heuristics always run without a key.
# GROQ_TAG_MAX_CALLS_PER_24H=48
# GROQ_TAG_MIN_INTERVAL_MS=30000
# Crime Ask (/api/crime/ask): prefers Groq when GROQ_API_KEY is set, else Ollama, else data heuristics.
# GROQ_CRIME_MAX_CALLS_PER_24H=80
# GROQ_CRIME_MIN_INTERVAL_MS=2000
# Ollama (local / your server): install from https://ollama.com, then ollama pull tinyllama:1.1b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_THREAT_MODEL=tinyllama:1.1b
# OLLAMA_THREAT_TIMEOUT_MS=90000

# Gas prices (/api/gas-prices): EIA weekly retail HTML (no key). Failures return
# gasUnavailable — no seeded/stale national average is invented.
# Optional: EIA_API_KEY for Open Data API. Free: https://www.eia.gov/opendata/register.php
# EIA_API_KEY=
# Alpha Vantage for /api/stocks (homepage stock widget). Free key: alphavantage.co
# ALPHAVANTAGE_API_KEY=

# NASA APOD (/api/space). Prefer a free personal key — DEMO_KEY is heavily rate-limited (429s on Render).
# Get one: https://api.nasa.gov/ — set NASA_API_KEY in Render env; never commit the key.
# NASA_API_KEY=
# Without a key the API falls back to DEMO_KEY, omits/stales APOD on 429, and still returns EONET + NASA News.

# Sex offender registry (CommunityGuardAPI). 100 free calls/month.
# Seed once: node scripts/seed-sex-offenders.js — runtime serves the on-disk pack only.
# COMMUNITYGUARD_API_KEY=
